# =============================================================================
# LOCAL + Docker Compose (infra: mysql, redis, mailpit)
# Copy:  cp .env.example .env
# Run:   docker compose up -d  &&  go run ./cmd/server  (or make.cmd run)
# =============================================================================

# Server
APP_ENV=development
APP_PORT=8080
APP_FRONTEND_URL=http://localhost:3000
# Behind reverse proxy only (empty = Gin trusts none — ClientIP = socket peer).
# Production sau reverse proxy (Render/nginx): BẮT BUỘC set CIDR proxy thật, ví dụ:
# TRUSTED_PROXIES=10.0.0.0/8
# Không còn default trust-all; để trống = không tin X-Forwarded-For.
TRUSTED_PROXIES=

# Database (app runs on host; Compose publishes MySQL on localhost)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=uam_db
DB_USER=uam_user
DB_PASSWORD=uam_password
DB_ROOT_PASSWORD=root_password
# Local compose MySQL usually runs without TLS. Production must use verify.
DB_TLS_MODE=disable
DB_TLS_CA_FILE=
DB_TLS_ALLOW_INSECURE=false
# Per API/worker replica; size these against the server-wide connection budget.
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5m
DB_CONN_MAX_IDLE_TIME=1m

# Redis (app runs on host; Compose publishes Redis on localhost)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Change both ports together when 6379 is reserved on the host.
REDIS_PUBLISHED_PORT=6379
REDIS_PASSWORD=
REDIS_POOL_SIZE=20
REDIS_MIN_IDLE_CONNS=2

# JWT (min 16 chars — change in real use)
JWT_SECRET=dev-only-change-me-min-16-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# Mail — Mailpit. Inbox UI: http://localhost:8025
# App trên host: SMTP_HOST=127.0.0.1 SMTP_PORT=1026 (map docker 1026:1025)
# App trong cùng compose network: SMTP_HOST=mailpit SMTP_PORT=1025
SMTP_HOST=127.0.0.1
SMTP_PORT=1026
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@localhost

# Blob storage — local is allowed only outside production.
BLOB_PROVIDER=local
BLOB_LOCAL_ROOT=./uploads
# S3 variables are unused while BLOB_PROVIDER=local.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=false

# Security
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m
RATE_LIMIT_BAN_DURATION=15m
MAX_FAILED_ATTEMPTS=5
LOCK_DURATION=30m
OTP_EXPIRY=5m
OTP_MAX_ATTEMPTS=5
PASSWORD_RESET_EXPIRY=1h
EMAIL_CHANGE_EXPIRY=15m
JSON_MAX_BYTES=65536
MULTIPART_MAX_BYTES=3145728
# Empty + non-production = fall back to JWT_SECRET.
# Production (APP_ENV=production): BẮT BUỘC set OTP_PEPPER riêng (không fallback).
OTP_PEPPER=

# TOTP MFA. Key ring entries use version:base64-encoded-32-byte-key.
MFA_ISSUER=User Access Management
MFA_ACTIVE_KEY_VERSION=v1
MFA_ENCRYPTION_KEYS=v1:ZGV2LW9ubHktbWZhLWtleS0zMi1ieXRlcy0wMDAwMDA=
MFA_CHALLENGE_TTL=5m
MFA_MAX_ATTEMPTS=5
MFA_RECOVERY_CODE_COUNT=10

# Max concurrent sessions per user (login kicks oldest). 0 = unlimited.
MAX_SESSIONS_PER_USER=10

# Background cleanup (expired sessions/verification challenges/password-reset tokens)
CLEANUP_INTERVAL=1h
CLEANUP_BATCH_SIZE=1000
CLEANUP_TABLE_BUDGET=5000
CLEANUP_TIMEOUT=2m
CLEANUP_LEASE_TTL=3m
# Delivered/dead-letter outbox rows are retained for investigation before cleanup.
OUTBOX_RETENTION=168h
# 0 = never delete audit_logs. e.g. 2160h = 90 days if policy allows.
AUDIT_RETENTION=0

# Durable outbox delivery
OUTBOX_POLL_INTERVAL=1s
OUTBOX_BATCH_SIZE=20
OUTBOX_CLAIM_TTL=2m
OUTBOX_TIMEOUT=30s
OUTBOX_MAX_CONCURRENT=4

# Health/metrics
READINESS_TIMEOUT=2s
# Empty keeps /metrics open in non-production; production omits the route.
METRICS_TOKEN=

# No administrator is seeded after migration 000019.
# Run cmd/bootstrap-admin once and supply UAM_BOOTSTRAP_ADMIN_PASSWORD through
# the process environment. Never store that password in this file.
