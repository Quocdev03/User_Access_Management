{
  "info": {
    "_postman_id": "uam-full-api-collection-v2",
    "name": "User Access Management (UAM) - Full API Suite",
    "description": "Bộ Postman Collection đầy đủ 41 semantic API endpoints + Health check của dự án UAM. Đã tích hợp sẵn dữ liệu body mẫu thực tế, tự động lưu token và có sẵn tài khoản Admin/User demo.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1",
      "type": "string"
    },
    {
      "key": "hostUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminEmail",
      "value": "admin@example.com",
      "type": "string"
    },
    {
      "key": "adminPassword",
      "value": "AdminPassword123!@#",
      "type": "string"
    },
    {
      "key": "demoEmail",
      "value": "demo@example.com",
      "type": "string"
    },
    {
      "key": "demoPassword",
      "value": "UserPassword123!@#",
      "type": "string"
    },
    {
      "key": "targetUserId",
      "value": "7",
      "type": "string"
    },
    {
      "key": "targetRoleId",
      "value": "3",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Health & Observability",
      "item": [
        {
          "name": "Liveness Probe",
          "request": {
            "method": "GET",
            "url": "{{hostUrl}}/health",
            "description": "Kiểm tra tiến trình HTTP server đang sống."
          }
        },
        {
          "name": "Readiness Probe (MySQL + Redis)",
          "request": {
            "method": "GET",
            "url": "{{hostUrl}}/health/ready",
            "description": "Kiểm tra kết nối MySQL và Redis đã sẵn sàng phục vụ traffic."
          }
        },
        {
          "name": "Swagger UI Docs",
          "request": {
            "method": "GET",
            "url": "{{hostUrl}}/swagger/index.html",
            "description": "Xem tài liệu Swagger tương tác."
          }
        }
      ]
    },
    {
      "name": "2. Authentication",
      "item": [
        {
          "name": "Đăng nhập Admin (Lấy Admin Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var res = pm.response.json();",
                  "    pm.collectionVariables.set('accessToken', res.data.access_token);",
                  "    pm.collectionVariables.set('refreshToken', res.data.refresh_token);",
                  "    console.log('Đã lưu Admin Access Token vào collection variable {{accessToken}}');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login",
            "description": "Đăng nhập với tài khoản Admin mặc định để lấy token quản trị."
          }
        },
        {
          "name": "Đăng nhập Demo User (Lấy User Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var res = pm.response.json();",
                  "    pm.collectionVariables.set('accessToken', res.data.access_token);",
                  "    pm.collectionVariables.set('refreshToken', res.data.refresh_token);",
                  "    console.log('Đã lưu User Access Token vào collection variable {{accessToken}}');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{demoEmail}}\",\n  \"password\": \"{{demoPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login",
            "description": "Đăng nhập với tài khoản người dùng demo."
          }
        },
        {
          "name": "Đăng ký tài khoản mới (Register)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "var ts = Date.now();",
                  "pm.variables.set('dyn_user', 'user_' + ts);",
                  "pm.variables.set('dyn_email', 'user_' + ts + '@example.test');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{dyn_user}}\",\n  \"email\": \"{{dyn_email}}\",\n  \"password\": \"Password123!@#\",\n  \"full_name\": \"Nguyễn Văn A\",\n  \"phone\": \"0901234567\",\n  \"date_of_birth\": \"1995-10-20\"\n}"
            },
            "url": "{{baseUrl}}/auth/register",
            "description": "Đăng ký tài khoản mới với username/email sinh tự động không trùng lặp."
          }
        },
        {
          "name": "Xác thực Email (Verify Email OTP)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@example.com\",\n  \"otp\": \"123456\"\n}"
            },
            "url": "{{baseUrl}}/auth/email/verify",
            "description": "Xác thực tài khoản bằng mã OTP 6 số nhận từ email (kiểm tra Mailpit tại http://localhost:8025)."
          }
        },
        {
          "name": "Gửi lại OTP xác thực Email (Resend Verification)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@example.com\"\n}"
            },
            "url": "{{baseUrl}}/auth/email/resend",
            "description": "Gửi lại mã OTP xác thực email khi mã cũ hết hạn."
          }
        },
        {
          "name": "Làm mới Access Token (Token Refresh)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var res = pm.response.json();",
                  "    pm.collectionVariables.set('accessToken', res.data.access_token);",
                  "    pm.collectionVariables.set('refreshToken', res.data.refresh_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/token/refresh",
            "description": "Sử dụng refresh_token để cấp cặp token mới (hỗ trợ single-rotation)."
          }
        },
        {
          "name": "Quên mật khẩu (Forgot Password)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@example.com\"\n}"
            },
            "url": "{{baseUrl}}/auth/password/forgot",
            "description": "Yêu cầu đặt lại mật khẩu qua email."
          }
        },
        {
          "name": "Đặt lại mật khẩu với Token (Reset Password)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"sample_reset_token_from_email\",\n  \"new_password\": \"NewPassword123!@#\"\n}"
            },
            "url": "{{baseUrl}}/auth/password/reset",
            "description": "Nhập token nhận từ email để tạo mật khẩu mới."
          }
        },
        {
          "name": "Đổi mật khẩu người dùng (Change Password - Authenticated)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"old_password\": \"UserPassword123!@#\",\n  \"new_password\": \"UserPasswordNew123!@#\"\n}"
            },
            "url": "{{baseUrl}}/auth/password/change",
            "description": "Đổi mật khẩu tài khoản hiện tại (yêu cầu mật khẩu cũ)."
          }
        },
        {
          "name": "Đổi mật khẩu bắt buộc (Force Change Password)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@example.com\",\n  \"temp_password\": \"TempPassword123!@#\",\n  \"new_password\": \"NewPassword123!@#\"\n}"
            },
            "url": "{{baseUrl}}/auth/password/force-change",
            "description": "Đổi mật khẩu khi tài khoản bị yêu cầu password_change_required."
          }
        },
        {
          "name": "Đăng xuất phiên hiện tại (Logout)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/logout",
            "description": "Thu hồi session hiện tại và blacklist access token."
          }
        },
        {
          "name": "Đăng xuất khỏi tất cả thiết bị (Logout All)",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/auth/logout-all",
            "description": "Tăng auth_version và vô hiệu hóa tất cả các phiên đăng nhập."
          }
        }
      ]
    },
    {
      "name": "3. Multi-Factor Authentication (MFA)",
      "item": [
        {
          "name": "Xem trạng thái MFA (MFA Status)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/mfa/status",
            "description": "Kiểm tra xem tài khoản hiện tại đã bật MFA hay chưa."
          }
        },
        {
          "name": "Bắt đầu thiết lập MFA (MFA Setup)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"current_password\": \"UserPassword123!@#\"\n}"
            },
            "url": "{{baseUrl}}/auth/mfa/setup",
            "description": "Yêu cầu sinh TOTP Secret và mã QR để thêm vào Google Authenticator."
          }
        },
        {
          "name": "Xác nhận và kích hoạt MFA (MFA Confirm)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"123456\"\n}"
            },
            "url": "{{baseUrl}}/auth/mfa/confirm",
            "description": "Nhập mã 6 số từ Google Authenticator để hoàn tất kích hoạt MFA."
          }
        },
        {
          "name": "Xác thực MFA khi đăng nhập (MFA Login Verify)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"challenge\": \"sample_challenge_token_from_login_response\",\n  \"code\": \"123456\"\n}"
            },
            "url": "{{baseUrl}}/auth/mfa/login/verify",
            "description": "Xác thực bước 2 bằng mã TOTP sau khi đăng nhập nhận được challenge."
          }
        },
        {
          "name": "Tạo lại danh sách Recovery Codes",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"current_password\": \"UserPassword123!@#\",\n  \"code\": \"123456\"\n}"
            },
            "url": "{{baseUrl}}/auth/mfa/recovery/regenerate",
            "description": "Sinh lại 10 mã dự phòng khẩn cấp khi người dùng bị mất mã cũ."
          }
        },
        {
          "name": "Tắt tính năng MFA (Disable MFA)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"current_password\": \"UserPassword123!@#\",\n  \"code\": \"123456\"\n}"
            },
            "url": "{{baseUrl}}/auth/mfa/disable",
            "description": "Tắt tính năng xác thực 2 bước cho tài khoản."
          }
        }
      ]
    },
    {
      "name": "4. User Profile & Settings",
      "item": [
        {
          "name": "Lấy thông tin cá nhân (Get Profile)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/users/me",
            "description": "Lấy thông tin profile, roles và quyền hạn của người dùng đang đăng nhập."
          }
        },
        {
          "name": "Cập nhật thông tin cá nhân (Update Profile)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Demo User Cập Nhật\",\n  \"phone\": \"0987654321\",\n  \"date_of_birth\": \"1998-08-20\"\n}"
            },
            "url": "{{baseUrl}}/users/me",
            "description": "Cập nhật họ tên, số điện thoại, ngày sinh của bản thân."
          }
        },
        {
          "name": "Yêu cầu đổi Email (Request Email Change)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"new_email\": \"newemail@example.com\",\n  \"current_password\": \"UserPassword123!@#\"\n}"
            },
            "url": "{{baseUrl}}/users/me/email/change-request",
            "description": "Gửi yêu cầu đổi email (hệ thống gửi OTP đến cả email cũ và email mới)."
          }
        },
        {
          "name": "Xác thực đổi Email (Verify Email Change)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"old_otp\": \"123456\",\n  \"new_otp\": \"654321\"\n}"
            },
            "url": "{{baseUrl}}/users/me/email/verify",
            "description": "Nhập OTP của cả email cũ và email mới để hoàn tất đổi email."
          }
        },
        {
          "name": "Gửi lại OTP đổi Email (Resend Change Email OTP)",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/users/me/email/resend",
            "description": "Gửi lại mã OTP đổi email khi bị hết hạn."
          }
        },
        {
          "name": "Tải lên ảnh đại diện (Upload Avatar)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "avatar",
                  "type": "file",
                  "src": "",
                  "description": "Chọn file ảnh PNG/JPEG dung lượng dưới 3MB"
                }
              ]
            },
            "url": "{{baseUrl}}/users/me/avatar",
            "description": "Tải lên file ảnh đại diện cá nhân."
          }
        },
        {
          "name": "Xóa ảnh đại diện (Delete Avatar)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/users/me/avatar",
            "description": "Xóa ảnh đại diện cá nhân và quay về avatar mặc định."
          }
        },
        {
          "name": "Danh sách phiên hoạt động (Get Sessions)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/users/me/sessions",
            "description": "Xem toàn bộ các thiết bị và phiên đăng nhập đang hoạt động."
          }
        },
        {
          "name": "Thu hồi một phiên cụ thể (Revoke Session)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/users/me/sessions/1",
            "description": "Đóng một phiên đăng nhập theo Session ID."
          }
        },
        {
          "name": "Danh sách thiết bị (Get Devices)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/users/me/devices",
            "description": "Xem lịch sử thiết bị và user agent đã từng đăng nhập."
          }
        }
      ]
    },
    {
      "name": "5. Admin - Quản lý Người dùng",
      "item": [
        {
          "name": "Danh sách người dùng (List Users)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/users?page=1&per_page=10&role=admin",
            "description": "Tìm kiếm, lọc và phân trang danh sách người dùng trong hệ thống."
          }
        },
        {
          "name": "Xem chi tiết người dùng (Get User)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/users/{{targetUserId}}",
            "description": "Xem chi tiết thông tin, roles và trạng thái của một tài khoản."
          }
        },
        {
          "name": "Cập nhật thông tin người dùng (Update User)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Demo User Quản Trị Cập Nhật\",\n  \"phone\": \"0911223344\",\n  \"date_of_birth\": \"1998-08-20\"\n}"
            },
            "url": "{{baseUrl}}/admin/users/{{targetUserId}}",
            "description": "Admin cập nhật thông tin hồ sơ cho người dùng khác."
          }
        },
        {
          "name": "Thay đổi trạng thái tài khoản (Change User Status)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"active\"\n}"
            },
            "url": "{{baseUrl}}/admin/users/{{targetUserId}}/status",
            "description": "Khóa, mở khóa hoặc kích hoạt tài khoản người dùng ('active', 'locked', 'disabled')."
          }
        },
        {
          "name": "Đặt lại mật khẩu cho User (Admin Password Reset)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"new_password\": \"NewAdminResetPassword123!@#\",\n  \"require_change\": true\n}"
            },
            "url": "{{baseUrl}}/admin/users/{{targetUserId}}/password-reset",
            "description": "Admin chủ động reset mật khẩu và bắt buộc đổi pass ở lần đăng nhập tới."
          }
        },
        {
          "name": "Gửi email thông báo cho User (Notify User)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subject\": \"Thông báo bảo trì hệ thống UAM\",\n  \"message\": \"Hệ thống sẽ bảo trì định kỳ vào lúc 02:00 sáng Chủ Nhật.\"\n}"
            },
            "url": "{{baseUrl}}/admin/users/{{targetUserId}}/notify",
            "description": "Gửi email thông báo trực tiếp đến người dùng qua Mail Outbox."
          }
        }
      ]
    },
    {
      "name": "6. Admin - Phân quyền & Roles (RBAC)",
      "item": [
        {
          "name": "Danh sách Roles (List Roles)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/roles",
            "description": "Xem toàn bộ các roles và danh sách permissions gán theo từng role."
          }
        },
        {
          "name": "Tạo Role mới (Create Role)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"manager\",\n  \"description\": \"Quản lý phòng ban nghiệp vụ\"\n}"
            },
            "url": "{{baseUrl}}/admin/roles",
            "description": "Tạo một role tùy chỉnh mới."
          }
        },
        {
          "name": "Xem chi tiết Role (Get Role)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/roles/{{targetRoleId}}",
            "description": "Xem thông tin và các permissions thuộc role chỉ định."
          }
        },
        {
          "name": "Cập nhật Role (Update Role)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"manager_lead\",\n  \"description\": \"Trưởng phòng quản lý nghiệp vụ\"\n}"
            },
            "url": "{{baseUrl}}/admin/roles/{{targetRoleId}}",
            "description": "Chỉnh sửa tên và mô tả của role (không được sửa tên role hệ thống)."
          }
        },
        {
          "name": "Thay thế danh sách Permissions của Role (Replace Permissions)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"permission_ids\": [\n    1,\n    2,\n    3\n  ]\n}"
            },
            "url": "{{baseUrl}}/admin/roles/{{targetRoleId}}/permissions",
            "description": "Cập nhật toàn bộ permissions của một role (bảo vệ không cho sửa role admin hệ thống)."
          }
        },
        {
          "name": "Gán Role cho User (Assign Role)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role_id\": 3\n}"
            },
            "url": "{{baseUrl}}/admin/users/{{targetUserId}}/roles",
            "description": "Gán thêm role cho một tài khoản người dùng."
          }
        },
        {
          "name": "Gỡ Role khỏi User (Remove Role)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/admin/users/{{targetUserId}}/roles/3",
            "description": "Gỡ bỏ role khỏi tài khoản (thực thi bảo vệ Last Admin Invariant)."
          }
        },
        {
          "name": "Xóa Role (Delete Role)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/admin/roles/{{targetRoleId}}",
            "description": "Xóa role tùy chỉnh (cấm xóa role hệ thống hoặc role đang có người sử dụng)."
          }
        }
      ]
    },
    {
      "name": "7. Admin - Audit Logs",
      "item": [
        {
          "name": "Xuất Audit Logs (Export Logs CSV / JSON)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/audit-logs/export?format=json&limit=50",
            "description": "Truy vấn và xuất nhật ký kiểm toán hành vi của hệ thống."
          }
        }
      ]
    }
