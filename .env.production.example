# =============================================================================
# PRODUCTION / test-prod — Render (Go + Redis) + Aiven MySQL + Resend
# Paste keys into Render Dashboard → Environment (do NOT commit real secrets)
# Source layout mirrors Render export (uam-api.env) — placeholders only here.
# =============================================================================

APP_ENV=production
APP_PORT=8080
# Frontend for CORS + password-reset links
APP_FRONTEND_URL=https://your-frontend.example.com
# Set reverse-proxy CIDR if ClientIP must use X-Forwarded-For.
# Empty = trust none (no default 0.0.0.0/0). Example behind private edge: 10.0.0.0/8
TRUSTED_PROXIES=

# --- Aiven MySQL ---
DB_HOST=xxxx.a.aivencloud.com
DB_PORT=28901
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=CHANGE_ME_AIVEN_PASSWORD
# Verified TLS is mandatory. Set the provider CA file when it is not in the system trust store.
DB_TLS_MODE=verify
DB_TLS_CA_FILE=
# Emergency only, with an explicit expiry/rollback ticket.
DB_TLS_ALLOW_INSECURE=false
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5m
DB_CONN_MAX_IDLE_TIME=1m

# --- Render Redis (Internal URL) ---
# Prefer full URL; leave REDIS_PORT empty when using redis:// or rediss://
REDIS_HOST=redis://red-xxxxxxxx:6379
REDIS_PORT=
REDIS_PASSWORD=
REDIS_POOL_SIZE=20
REDIS_MIN_IDLE_CONNS=2

# --- JWT ---
JWT_SECRET=CHANGE_ME_LONG_RANDOM_MIN_32_CHARS
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# --- Resend SMTP (domain From must be verified on resend.com) ---
SMTP_HOST=smtp.resend.com
# Dùng 587 (STARTTLS) hoặc 465 (SSL). KHÔNG dùng 2525 (không phải port Resend).
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=re_CHANGE_ME
SMTP_FROM=noreply@your-domain.com

# --- S3-compatible avatar storage ---
BLOB_PROVIDER=s3
# Used only as the read source for the one-off cmd/avatar-migrate job.
BLOB_LOCAL_ROOT=/mnt/legacy-uploads
# Empty endpoint uses AWS S3; set an HTTPS endpoint for R2/MinIO-compatible providers.
S3_ENDPOINT=https://s3.example.com
S3_REGION=auto
S3_BUCKET=uam-avatars
# Inject through the deployment secret manager. Leave both empty when using workload identity.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=https://avatars.example.com
S3_FORCE_PATH_STYLE=true

# --- Security ---
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m
RATE_LIMIT_BAN_DURATION=15m
MAX_FAILED_ATTEMPTS=5
LOCK_DURATION=15m
OTP_EXPIRY=5m
OTP_MAX_ATTEMPTS=3
PASSWORD_RESET_EXPIRY=1h
EMAIL_CHANGE_EXPIRY=15m
JSON_MAX_BYTES=65536
MULTIPART_MAX_BYTES=3145728
# Stable random string; do not rotate casually (invalidates pending OTPs)
# Required when APP_ENV=production (app refuses empty — no JWT_SECRET fallback).
OTP_PEPPER=CHANGE_ME_OTP_PEPPER

# Required. Keep old versioned entries during rotation so existing secrets remain readable.
MFA_ISSUER=User Access Management
MFA_ACTIVE_KEY_VERSION=v1
MFA_ENCRYPTION_KEYS=v1:CHANGE_ME_BASE64_32_BYTE_KEY
MFA_CHALLENGE_TTL=5m
MFA_MAX_ATTEMPTS=5
MFA_RECOVERY_CODE_COUNT=10

# --- Cleanup worker ---
CLEANUP_INTERVAL=1h
CLEANUP_BATCH_SIZE=1000
CLEANUP_TABLE_BUDGET=5000
CLEANUP_TIMEOUT=2m
CLEANUP_LEASE_TTL=3m
OUTBOX_RETENTION=168h
# Set according to the audit retention policy; 0 disables audit deletion.
AUDIT_RETENTION=0

# --- Durable outbox delivery ---
OUTBOX_POLL_INTERVAL=1s
OUTBOX_BATCH_SIZE=20
OUTBOX_CLAIM_TTL=2m
OUTBOX_TIMEOUT=30s
OUTBOX_MAX_CONCURRENT=4

# --- Health/metrics ---
READINESS_TIMEOUT=2s
# Required to expose /metrics in production. Inject from the secret manager.
METRICS_TOKEN=CHANGE_ME_LONG_RANDOM_METRICS_TOKEN

# No administrator is seeded. Run cmd/bootstrap-admin as an audited one-off
# command; inject UAM_BOOTSTRAP_ADMIN_PASSWORD from the deployment secret store.
